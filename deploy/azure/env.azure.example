# Copy to deploy/azure/.env.azure and fill in secrets.
# Used by deploy/azure/03-deploy-app.sh — every key here is pushed to the Container App
# (except POSTGRES_PASSWORD, which is only for local restore scripts).

# --- Core ---
DOMAIN=sign.incitegravity.com
SECRET_KEY=replace-with-generated-secret
ENCRYPTION_KEY=replace-with-generated-fernet-key
DEBUG=false

ALLOWED_HOSTS=sign.incitegravity.com
CSRF_TRUSTED_ORIGINS=https://sign.incitegravity.com
SECURE_COOKIES=true
SECURE_HSTS_SECONDS=31536000
SITE_URL=https://sign.incitegravity.com
TRUSTED_PROXY_COUNT=1

# --- Database ---
# URL-encode special characters in the password. sslmode=require for Azure Postgres.
DATABASE_URL=postgres://dscapi:REPLACE_PASSWORD@YOUR_PG_HOST.postgres.database.azure.com:5432/dscapi?sslmode=require
POSTGRES_PASSWORD=REPLACE_PASSWORD

# --- Security / auth ---
ALLOW_BASIC_AUTH=false
VERIFY_EMAIL_TOKEN_HOURS=24
PASSWORD_RESET_TOKEN_HOURS=2
SESSION_COOKIE_AGE=604800
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# --- Rate limits (portal + API signing) ---
CACHE_BACKEND=database
RATELIMIT_DEFAULT_LIMIT=60
RATELIMIT_DEFAULT_PERIOD=900
THROTTLE_SIGN_PDF=300/hour
THROTTLE_SIGN_PDF_BURST=60/min
THROTTLE_AGENT_PAIR=10/hour
THROTTLE_AGENT_HEARTBEAT=120/hour
THROTTLE_AGENT_JOB=120/hour

# --- Upload / PDF limits ---
API_SIGN_MAX_UPLOAD_MB=10
PFX_MAX_UPLOAD_MB=5
SIGNATURE_MAX_SLOTS=20
PDF_MAX_PAGE_COUNT=200

# --- Teams / quota notifications ---
TEAMS_ENABLED=true
TEAM_INVITE_HOURS=72
DEFAULT_MONTHLY_QUOTA=100
QUOTA_NOTIFICATIONS_ENABLED=true
QUOTA_EXPIRY_REMINDER_DAYS=30
QUOTA_LOW_REMAINING_PERCENT=10

# --- Gunicorn ---
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=180

# --- Bootstrap admin (optional; remove ADMIN_PASSWORD after first boot) ---
# ADMIN_EMAIL=admin@incitegravity.com
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# --- Email (Microsoft 365) ---
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@incitegravity.com
EMAIL_HOST_PASSWORD=replace-with-mailbox-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=30
DEFAULT_FROM_EMAIL=noreply@incitegravity.com

# --- GST (MyGSTCafe — platform-held) ---
GST_MYGSTCAFE_CUSTOMER_ID=
GST_MYGSTCAFE_API_ID=
GST_MYGSTCAFE_API_SECRET=
GST_MYGSTCAFE_ENVIRONMENT=Production
GST_MYGSTCAFE_TIMEOUT_SECONDS=30
GST_PARTNER_BASE_URL=https://gstapi.mygstcafe.com
GST_EWAY_BASE_URL=https://ewayapi.mygstcafe.com
GST_EINVOICE_BASE_URL=https://api.mygstcafe.com
GST_EINVOICE_BASE_URL_SANDBOX=https://testapi.mygstcafe.com
THROTTLE_GST_LOOKUP=120/hour
THROTTLE_GST_LOOKUP_BURST=20/min
GST_ALLOW_NIC_API_OVERRIDES=false

# --- USB agent (optional) ---
# USB_AGENT_MICROSOFT_STORE_URL=
# USB_AGENT_PAIRING_TTL_MINUTES=5
# USB_AGENT_SIGN_JOB_TTL_MINUTES=15
# USB_AGENT_HEARTBEAT_TIMEOUT_SECONDS=90
